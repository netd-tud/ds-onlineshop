      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Product Recommendations per Product",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bftkgey00zqbkc"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH mirrored AS (\n  SELECT sku_a, sku_b, co_purchase_count FROM product_recommendations\n  UNION ALL\n  SELECT sku_b AS sku_a, sku_a AS sku_b, co_purchase_count FROM product_recommendations\n)\nSELECT\n  p_row.name AS \"Product_A\",\n  p_col.name AS \"Product_B\",\n  m.co_purchase_count AS \"Count\"\nFROM products p_row\nCROSS JOIN products p_col\nLEFT JOIN mirrored m \n  ON m.sku_a = p_row.sku AND m.sku_b = p_col.sku\nORDER BY p_row.name ASC, p_col.name ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
