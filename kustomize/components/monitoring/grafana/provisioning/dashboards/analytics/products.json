                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT \n  $__timeGroupAlias(window_start, '1m'),\n  p.name AS metric,\n  SUM(total_clicks) AS clicks\nFROM product_clicks_1m c\nJOIN products p ON c.sku = p.sku\nWHERE $__timeFilter(window_start)\nGROUP BY 1, 2\nORDER BY 1, 2;",
