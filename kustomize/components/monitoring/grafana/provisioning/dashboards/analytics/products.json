                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "groupingToMatrix",
                  "spec": {
                    "options": {
                      "columnField": "Product_A",
                      "emptyValue": "null",
                      "rowField": "Product_B",
                      "valueField": "Count"
                    }
                  }
                }
              ],
              "queryOptions": {}
