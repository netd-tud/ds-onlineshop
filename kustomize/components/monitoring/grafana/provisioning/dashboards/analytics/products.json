                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT DISTINCT ON (r.sku_a) \n    a.name AS \"Product\", \n    b.name AS \"Top Recommendation\", \n    r.co_purchase_count AS \"Co-Purchases\"\nFROM product_recommendations r\nJOIN products a ON r.sku_a = a.sku\nJOIN products b ON r.sku_b = b.sku\nORDER BY r.sku_a, r.co_purchase_count DESC;",
